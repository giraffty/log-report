{
  "name": "log-report",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giraffty/log-report.git"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:tools": "tsc -p tsconfig.tools.json",
    "check:lint": "eslint . --max-warnings 0",
    "check:styles": "stylelint \"src/**/*.{css,svelte}\" --max-warnings 0",
    "check:format": "prettier --check .",
    "check:deadcode": "knip",
    "check": "pnpm check:types && pnpm check:tools && pnpm check:lint && pnpm check:styles && pnpm check:format && pnpm check:deadcode",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:browser": "playwright install chromium",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "knip": "^6.41.0",
    "playwright": "^1.64.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@giraffty/ui": "^0.16.0",
    "neverthrow": "^8.2.0",
    "ts-pattern": "^5.9.2",
    "zod": "^4.6.7"
  }
}
